NODE_ENV=development
PORT=3067

# MongoDB (puede ser local o Docker)
URI_MONGO=mongodb://localhost:27017/DBAISentinel

# JWT: MISMO secret que server-auth-aisentinel/.env
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=replace-me-with-64-bytes-base64url
JWT_ISSUER=AuthService
JWT_AUDIENCE=AuthService

# Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# URL del servicio de auth (firma los JWT)
AUTH_SERVICE_URL=http://localhost:3069

# Internal API Token (debe coincidir con server-auth-aisentinel/.env)
INTERNAL_API_TOKEN=replace-me-with-random-hex

# Servicio de IA (FastAPI / YOLO). Usar 127.0.0.1 en vez de localhost
# para evitar que Windows resuelva primero a IPv6 (::1) y timeoute contra
# el puerto 8000 que Docker expone solo en IPv4.
PYTHON_SERVER_URL=http://127.0.0.1:8000
# Dejar vacio: el pyimage esta en modo desarrollo y permite todo si la key esta unset.
INTERNAL_API_KEY=

# Directorio donde se guardan los videos subidos desde el frontend.
# Por defecto: server-admin-aisentinel/uploads/camera-videos
VIDEO_UPLOAD_DIR=./uploads/camera-videos

# Rate limit general (front-end)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=600

# Rate limit para automatic-detection (tótems)
RATE_LIMIT_AUTODETECTION_WINDOW_MS=900000
RATE_LIMIT_AUTODETECTION_MAX_REQUESTS=3000

# SMTP (recomendado Gmail con App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=AI Sentinel App
